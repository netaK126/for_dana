\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Worked example of perturbed-interval propagation for the neuron with weight row $(1,-2)$ under $\varepsilon =0.1$. Each input neuron is labelled with its weight on the edge to neuron $k$, and each edge carries the up and down per-edge contributions $w\cdot \Delta ^{a,\uparrow }_{0}$ and $w\cdot \Delta ^{a,\downarrow }_{0}$; with $\Delta ^{a}_0\in [-0.1,0.1]$ per coordinate, summing them gives the pre-activation drift $[-0.3,0.3]$, and the ReLU clip leaves $[\Delta ^{a,\downarrow }_{1,k},\Delta ^{a,\uparrow }_{1,k}]=[-0.3,0.3]$, which couples the two copies and is added to the MIP.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:pi_example}{{1}{9}{Worked example of perturbed-interval propagation for the neuron with weight row $(1,-2)$ under $\ep =0.1$. Each input neuron is labelled with its weight on the edge to neuron $k$, and each edge carries the up and down per-edge contributions $w\cdot \Delta ^{a,\uparrow }_{0}$ and $w\cdot \Delta ^{a,\downarrow }_{0}$; with $\Delta ^{a}_0\in [-0.1,0.1]$ per coordinate, summing them gives the pre-activation drift $[-0.3,0.3]$, and the ReLU clip leaves $[\Delta ^{a,\downarrow }_{1,k},\Delta ^{a,\uparrow }_{1,k}]=[-0.3,0.3]$, which couples the two copies and is added to the MIP}{figure.1}{}}
